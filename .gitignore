# Android
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties
android-app/.idea/
android-app/*.iml
android-app/app/*.iml
android-app/app/google-services.json

# Signing keys. A keystore in the repo means its private key is permanently
# recoverable from git history, so it can never sign anything you publish.
# Supply it to CI as a base64 secret instead — see BUILD_AND_INSTALL.md.
# NOTE: android-app/app/release.keystore is already TRACKED and so is not
# covered by these patterns; it needs `git rm --cached` to untrack.
*.keystore
*.jks

# Backend
backend/__pycache__/
backend/*.pyc
backend/workspace/
backend/*.log
backend/*.pdf
backend/generation_runs.db

# Magazine Analysis (large PDFs)
magazine-analysis/source-pdfs/

# OS
.DS_Store
Thumbs.db
*.swp

# Agent files
.agents/
*.pyc
__pycache__/

# Temp files
check_space.py
create_space.py
mock_bg.png
TEST_INFRA.md
TEST_READY.md
