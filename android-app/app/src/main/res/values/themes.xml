<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MagazineForge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0F0F10</item>
        <item name="android:navigationBarColor">#0F0F10</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animate the icon, and set the post-splash theme. -->
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MagazineForge</item>
    </style>
</resources>
